<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.estoque.controller.AlertasController">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox>
            <Label text="Alertas de Reposição" styleClass="view-title" />
            <Label text="Produtos que atingiram ou estão abaixo do ponto de pedido" style="-fx-text-fill: #7f8c8d;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblContagemAlertas" text="0 itens em alerta" 
               style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 5 15; -fx-background-radius: 15; -fx-font-weight: bold;" />
    </HBox>

    <TableView fx:id="tabelaAlertas" VBox.vgrow="ALWAYS" style="-fx-border-color: #e67e22;">
        <columns>
            <TableColumn fx:id="colunaId" text="ID" prefWidth="50.0" />
            <TableColumn fx:id="colunaNome" text="Nome" prefWidth="200.0" />
            <TableColumn fx:id="colunaEstoque" text="Estoque Atual" prefWidth="120.0" />
            <TableColumn fx:id="colunaPontoPedido" text="Ponto de Pedido" prefWidth="120.0" />
            <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="120.0" />
        </columns>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Label text="* Sugestão de compra baseada no estoque de segurança" style="-fx-font-style: italic; -fx-text-fill: #95a5a6;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Atualizar Alertas" onAction="#carregarAlertas" styleClass="btn-primary" />
    </HBox>
</VBox>
