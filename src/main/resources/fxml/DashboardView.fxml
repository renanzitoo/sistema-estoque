<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.estoque.controller.DashboardController"
            prefWidth="1100.0" prefHeight="700.0" stylesheets="@../css/style.css">

    <!-- Sidebar Lateral -->
    <left>
        <VBox spacing="10" styleClass="sidebar" prefWidth="220">
            <Label text="ESTOQUE PRO" styleClass="sidebar-title">
                <VBox.margin>
                    <Insets bottom="20"/>
                </VBox.margin>
            </Label>

            <Button fx:id="btnDashboard" text="🏠 Dashboard" styleClass="nav-button, nav-button-active" 
                    maxWidth="Infinity" onAction="#showDashboard"/>
            <Button fx:id="btnProdutos" text="📦 Produtos" styleClass="nav-button" 
                    maxWidth="Infinity" onAction="#showProdutos"/>
            <Button fx:id="btnAlertas" text="⚠️ Alertas" styleClass="nav-button" 
                    maxWidth="Infinity" onAction="#showAlertas"/>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Separator />
            <Button text="🚪 Sair" styleClass="nav-button" maxWidth="Infinity" onAction="#handleSair"/>
        </VBox>
    </left>

    <!-- Área de Conteúdo Central -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <!-- O conteúdo será carregado aqui dinamicamente -->
            <VBox fx:id="homeView" spacing="20">
                <Label text="Bem-vindo ao Sistema de Controle" styleClass="view-title" />
                
                <GridPane hgap="20" vgap="20">
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                          GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="280">
                        <Label text="Total de Produtos" style="-fx-text-fill: #7f8c8d;" />
                        <Label fx:id="lblTotalProdutos" text="0" style="-fx-font-size: 32; -fx-font-weight: bold;" />
                        <Button text="Ver Todos" onAction="#showProdutos" styleClass="nav-button" style="-fx-text-fill: #3498db; -fx-padding: 0;" />
                    </VBox>
                    
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                          GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="280">
                        <Label text="Itens em Alerta" style="-fx-text-fill: #e67e22;" />
                        <Label fx:id="lblProdutosAlerta" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #e67e22;" />
                        <Button text="Ver Detalhes" onAction="#showAlertas" styleClass="nav-button" style="-fx-text-fill: #e67e22; -fx-padding: 0;" />
                    </VBox>
                </GridPane>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
